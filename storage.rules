rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // mainVideo / previewVideo uploads from the create-sub-concept page.
    // Read stays auth-gated to match the rest of the app; playback URLs
    // returned by getDownloadURL() carry their own access token, so this
    // mainly governs SDK access, not the stored <video src> URLs themselves.
    match /videos/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 500 * 1024 * 1024
                   && request.resource.contentType.matches('video/.*');
    }
  }
}
