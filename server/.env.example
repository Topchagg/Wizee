# Port is 5433, not Postgres's default 5432 — matches docker-compose.yml's
# POSTGRES_PORT default (changed to dodge a host port conflict). User/password
# here must match POSTGRES_USER/POSTGRES_PASSWORD in the root .env.
DATABASE_URL="postgresql://wizee:wizee@localhost:5433/wizee?schema=public"

# Next.js (client) also defaults to 3000 — keep this different so running the
# server locally never fights the client for the same port.
PORT=4000

# Firebase Admin SDK — from Firebase Console > Project Settings > Service Accounts
# > Generate new private key. Paste the downloaded JSON's matching fields below.
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
